#include<bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i=0;i<n;i++)
    {
        cin>>arr[i];
    }
    unordered_map<int,int>b;
    for(int i:arr)
    {
        b[i]++;
    }
    int g=0;
    for(auto x:b)
    {
        g=g+(x.second)/2;
    }
    cout<<g;
}
